# ---------- core ----------
# Docker deployment only: domain served by Caddy (HTTPS) and the Postgres password
APP_DOMAIN=studio.example.com
POSTGRES_PASSWORD=change-me
NODE_ENV=development
DATABASE_URL=postgres://media:media@localhost:5432/media_studio
# Public base URL of the web app (used in Telegram links and as STORAGE_PUBLIC_BASE_URL fallback)
APP_BASE_URL=http://localhost:3000
# Secret for signing short-lived media URLs and Telegram callback payloads (>= 32 random chars)
APP_SECRET=change-me-to-a-long-random-string-0123456789

# ---------- storage ----------
# local | s3 (Cloudflare R2 is S3-compatible)
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# For local storage, external services fetch media through the web app: ${APP_BASE_URL}/media
STORAGE_PUBLIC_BASE_URL=
# R2: https://<account-id>.r2.cloudflarestorage.com, region "auto"
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom domain bound to the bucket, e.g. https://media.yourdomain.com
S3_PUBLIC_BASE_URL=
STORAGE_CACHE_DIR=./data/cache

# ---------- AI providers (leave empty to use only the mock providers) ----------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
# MiniMax API host (global platform)
MINIMAX_API_BASE=https://api.minimax.io
XAI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# ---------- worker ----------
# DBOS durable workflow state (can be the same database)
DBOS_SYSTEM_DATABASE_URL=postgres://media:media@localhost:5432/media_studio_dbos
# Max concurrent video productions / hero-clip generations
PRODUCTION_CONCURRENCY=2
CLIP_CONCURRENCY=3
# Remotion: path to Chrome Headless Shell / Chromium (optional; Remotion downloads one if empty)
REMOTION_BROWSER_EXECUTABLE=
# whisper.cpp install dir for word-level caption alignment (optional; falls back to estimated timings)
WHISPER_CPP_DIR=./data/whisper
WHISPER_MODEL=base.en

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
